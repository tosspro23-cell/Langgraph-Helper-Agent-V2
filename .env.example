# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values you need.
# Only the LLM provider key is required. Everything else has a sane default.
# ---------------------------------------------------------------------------

# Which mode to run in when --mode is not passed on the CLI: offline | online
AGENT_MODE=offline

# Which LLM provider to use: gemini | openrouter | ollama
LLM_PROVIDER=gemini

# --- Gemini (default, recommended) -----------------------------------------
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
# "-lite" models get the most generous free-tier request quota; "-latest"
# aliases and brand-new preview models (e.g. this was gemini-3.7-flash at
# time of writing) have much stricter free-tier limits (as low as 20
# requests/day) since they're new/experimental. If you hit a 429
# RESOURCE_EXHAUSTED error, wait a bit or switch to another free model
# (see: https://ai.google.dev/gemini-api/docs/rate-limits).
GEMINI_MODEL=gemini-3.5-flash-lite

# --- OpenRouter (alternative, OpenAI-compatible API) ------------------------
# Get a free key at https://openrouter.ai/keys (many models have a free tier,
# e.g. "google/gemini-2.0-flash-exp:free" or "meta-llama/llama-3.3-70b-instruct:free")
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# --- Ollama (alternative, fully local, no API key) ---------------------------
# Install from https://ollama.com and `ollama pull llama3.1` first
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- Online mode: web search backend ----------------------------------------
# Tavily is used automatically if TAVILY_API_KEY is set; otherwise the agent
# falls back to DuckDuckGo (ddgs), which needs no API key at all.
# Free Tavily key: https://app.tavily.com (1,000 searches/month free tier)
TAVILY_API_KEY=

# Number of retrieved chunks / search results fed to the LLM as context
RETRIEVAL_K=5
